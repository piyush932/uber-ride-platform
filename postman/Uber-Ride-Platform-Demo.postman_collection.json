{"info":{"name":"Uber Ride Platform - Gateway Demo","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json","description":"Run all requests in order without delays. Local disposable data only. On interruption, use saved ids/tokens for cleanup."},"event":[{"listen":"prerequest","script":{"type":"text/javascript","exec":["if (!pm.environment.get('baseUrl')) pm.variables.set('baseUrl', 'http://127.0.0.1:8080');","if (!pm.collectionVariables.get('runId')) { const id = pm.variables.replaceIn('{{$guid}}'); pm.collectionVariables.set('runId', id); pm.collectionVariables.set('testPassword', 'Demo-' + id); }"]}},{"listen":"test","script":{"type":"text/javascript","exec":["const n = pm.info.requestName; const expected = n.includes('signup') ? 201 : (n === 'Driver online' || n === 'Driver offline' ? 204 : 200);","pm.test('Expected HTTP status', () => pm.expect(pm.response.code).to.eql(expected));","if (pm.response.code !== expected) { pm.execution.setNextRequest(null); } else if (expected !== 204) {"," const d = pm.response.json(); const set = (k,v) => pm.collectionVariables.set(k,v);"," if (n === 'Passenger login') set('passengerToken',d.token);"," if (n === 'Driver login') set('driverToken',d.token);"," if (n === 'Passenger profile') set('passengerId',d.id);"," if (n === 'Driver profile') set('driverId',d.id);"," if (n === 'Create booking') { set('bookingId',d.id); pm.test('PENDING',()=>pm.expect(d.status).to.eql('PENDING')); }"," if (n === 'Find offer') { const a = d.offers.filter(o=>String(o.bookingId)===String(pm.collectionVariables.get('bookingId'))); pm.test('One live offer',()=>pm.expect(a.length).to.eql(1)); if(a.length===1) set('offerId',a[0].id); else pm.execution.setNextRequest(null); }"," if (n === 'Passenger status') pm.test('COMPLETED',()=>pm.expect(d.status).to.eql('COMPLETED'));","}"]}}],"item":[{"name":"Passenger signup","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/v1/auth/signup","body":{"mode":"raw","raw":"{\"name\":\"Postman Passenger\",\"email\":\"passenger-{{runId}}@example.com\",\"password\":\"{{testPassword}}\"}"}}},{"name":"Passenger login","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/v1/auth/login","body":{"mode":"raw","raw":"{\"email\":\"passenger-{{runId}}@example.com\",\"password\":\"{{testPassword}}\"}"}}},{"name":"Passenger profile","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{passengerToken}}"}],"url":"{{baseUrl}}/api/v1/auth/me"}},{"name":"Driver signup","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/v1/auth/signup/driver","body":{"mode":"raw","raw":"{\"name\":\"Postman Driver\",\"email\":\"driver-{{runId}}@example.com\",\"password\":\"{{testPassword}}\"}"}}},{"name":"Driver login","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/v1/auth/login/driver","body":{"mode":"raw","raw":"{\"email\":\"driver-{{runId}}@example.com\",\"password\":\"{{testPassword}}\"}"}}},{"name":"Driver profile","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{driverToken}}"}],"url":"{{baseUrl}}/api/v1/auth/driver/me"}},{"name":"Driver online","request":{"method":"PUT","header":[{"key":"Authorization","value":"Bearer {{driverToken}}"},{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/v1/locations/drivers/{{driverId}}","body":{"mode":"raw","raw":"{\"latitude\":26.34567,\"longitude\":76.45678}"}}},{"name":"Create booking","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{passengerToken}}"},{"key":"Content-Type","value":"application/json"},{"key":"Idempotency-Key","value":"{{$guid}}"}],"url":"{{baseUrl}}/api/v1/bookings","body":{"mode":"raw","raw":"{\"passengerId\":{{passengerId}},\"pickupLatitude\":26.34567,\"pickupLongitude\":76.45678,\"dropLatitude\":26.35567,\"dropLongitude\":76.46678}"}}},{"name":"Find offer","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{driverToken}}"}],"url":"{{baseUrl}}/api/v1/driver/dashboard"}},{"name":"Accept offer","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{driverToken}}"}],"url":"{{baseUrl}}/api/v1/driver/offers/{{offerId}}/accept"}},{"name":"Start trip","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{driverToken}}"}],"url":"{{baseUrl}}/api/v1/driver/rides/{{bookingId}}/start"}},{"name":"Complete trip","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{driverToken}}"}],"url":"{{baseUrl}}/api/v1/driver/rides/{{bookingId}}/complete"}},{"name":"Passenger status","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{passengerToken}}"}],"url":"{{baseUrl}}/api/v1/bookings/{{bookingId}}"}},{"name":"Driver history","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{driverToken}}"}],"url":"{{baseUrl}}/api/v1/driver/rides"}},{"name":"Driver offline","request":{"method":"DELETE","header":[{"key":"Authorization","value":"Bearer {{driverToken}}"}],"url":"{{baseUrl}}/api/v1/locations/drivers/{{driverId}}"}}]}
