<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>uber-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>uber-backend</name>
    <description>Parent POM for the Uber ride platform services</description>

    <properties>
        <!-- bytecode level; the code still runs on newer JDKs such as 21 or 25 -->
        <java.version>17</java.version>
        <spring-cloud.version>2025.0.3</spring-cloud.version>
        <!-- 1.18.40 or newer is needed to compile on JDK 25 -->
        <lombok.version>1.18.42</lombok.version>
        <jjwt.version>0.12.5</jjwt.version>
    </properties>

    <modules>
        <module>entity-service</module>
        <module>eureka-server</module>
        <module>auth-service</module>
        <module>location-service</module>
        <module>socket-service</module>
        <module>booking-service</module>
        <module>review-service</module>
        <module>api-gateway</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
