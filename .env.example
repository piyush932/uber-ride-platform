# Copy this file to .env (git-ignored) and replace both values before running docker compose.
# Generate a JWT secret in PowerShell:
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
MYSQL_ROOT_PASSWORD=change-me-local-only
JWT_SECRET=change-me-at-least-32-characters-long-random

# Optional
# GATEWAY_PROFILES=redis            enables gateway rate limiting (the smoke tests need it off)
# BOOKING_PROFILES=mysql,kafka      publishes booking events to Kafka; start with: docker compose --profile kafka up -d
# BOOKING_OFFER_TTL_SECONDS=20
# BOOKING_OFFER_MAX_ATTEMPTS=5
# LOCATION_TTL_SECONDS=300
